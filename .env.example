# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，请勿提交）
#
# JWT_SECRET_KEY 与 ENCRYPTION_KEY 首次启动会自动生成强随机值写入 .env，
# 也可自行填入 ≥32 字节随机串，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"

# ===== API 服务（默认值与 app/config.py 一致）=====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ===== 数据库：默认 SQLite（开箱即用，无需外部数据库）=====
DB_TYPE=sqlite
DB_PATH=data/miapi.db

# 切换 PostgreSQL（需 `pip install asyncpg`）：
#   DB_TYPE=postgresql
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_USER=miapi
#   DB_PASSWORD=your_db_password
#   DB_NAME=miapi
# 或直接给出完整连接串（优先于以上分项）：
#   DATABASE_URL=postgresql+asyncpg://miapi:your_db_password@localhost:5432/miapi

# ===== JWT 认证 =====
# 生产环境务必改为强随机值，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ===== 小米账户（可选，多用户模式下由用户在界面添加）=====
MI_USER=
MI_PASS=

# ===== 平台 =====
REGISTRATION_ENABLED=true
MAX_DEVICES_PER_USER=10
MAX_API_KEYS_PER_USER=10

# ===== 定时清理 / 数据保留（默认值与 app/config.py 一致）=====
CLEANUP_ENABLED=true
CLEANUP_HOUR=2
CLEANUP_MINUTE=0
TIMEZONE=Asia/Shanghai
API_LOGS_RETENTION_DAYS=90
SPEAK_TASKS_RETENTION_DAYS=7
USER_ACTIVITIES_RETENTION_DAYS=30
LOG_FILES_RETENTION_DAYS=7
NOTIFICATION_LOGS_RETENTION_DAYS=30

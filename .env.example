# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，请勿提交）

# ===== API 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ===== 数据库 (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=miapi
DB_PASSWORD=          # 必填：数据库密码
DB_NAME=miapi

# ===== JWT 认证 =====
# 生产环境务必改为强随机值，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ===== 小米账户（可选，多用户模式下由用户在界面添加）=====
MI_USER=
MI_PASS=

# ===== 平台 =====
REGISTRATION_ENABLED=true
MAX_DEVICES_PER_USER=10
MAX_API_KEYS_PER_USER=10

# ===== 定时清理 / 数据保留 =====
CLEANUP_ENABLED=true
TIMEZONE=Asia/Shanghai
API_LOGS_RETENTION_DAYS=90
SPEAK_TASKS_RETENTION_DAYS=7
USER_ACTIVITIES_RETENTION_DAYS=30
